# ============================================================================
# SIEM runtime configuration (copy to .env and adjust)
# All values have safe development defaults.
# ============================================================================

# --- App ---------------------------------------------------------------------
APP_NAME="SIEM Platform"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-please
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]
RATE_LIMIT_PER_MINUTE=120

# --- Database (metadata). SQLite default; PostgreSQL for production ----------
# DATABASE_URL=sqlite:///./data/siem.db
DATABASE_URL=postgresql+psycopg://siem:siem@localhost:5432/siem

# --- Event bus (redis://..., or inmemory:// for dev/tests) -------------------
EVENT_BUS_URL=redis://localhost:6379/0
# EVENT_BUS_URL=inmemory://

# --- Log store (elasticsearch://..., or local://./data/events for dev/tests)-
LOG_STORE_URL=elasticsearch://localhost:9200
# LOG_STORE_URL=local://./data/events
LOG_STORE_INDEX_PREFIX=siem-events
LOG_STORE_DAY_ROLLOVER=true
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=siem-dev-password
ELASTICSEARCH_VERIFY_TLS=false

# --- AI Agent ----------------------------------------------------------------
# heuristic | openai | groq | ollama
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
AI_MAX_EVENTS_CONTEXT=25

# --- SOAR --------------------------------------------------------------------
SOAR_ALLOW_DESTRUCTIVE=false
SOAR_WEBHOOK_DEFAULT_URL=
SOAR_ENDPOINT_ISOLATION_API=
SOAR_FIREWALL_BLOCK_API=

# --- Alerting ----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=siem@localhost
ALERT_WEBHOOK_DEFAULT_URL=

# --- ML / detection ----------------------------------------------------------
ML_MODEL_DIR=./data/ml
ML_ANOMALY_THRESHOLD=0.62
YARA_RULES_DIR=./data/yara
YARA_ENABLED=true

# --- Super admin bootstrap ---------------------------------------------------
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=Admin@12345
FIRST_ADMIN_EMAIL=admin@localhost

# --- Retention ---------------------------------------------------------------
RETENTION_HOT_DAYS=7
RETENTION_WARM_DAYS=30
RETENTION_COLD_DAYS=90
RETENTION_DELETE_DAYS=180
